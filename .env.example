# =======================================================================
# Expense AI Service (FastAPI / PyTorch / OCR / NLU)
# Sao chép tệp này thành .env và điền các giá trị thực tế.
# =======================================================================

# --- Cấu hình máy chủ dịch vụ ---
APP_NAME=Expense AI Service (Unified)
ENVIRONMENT=local
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEVICE=cpu                     # 'cpu' hoặc 'cuda' (nếu máy có GPU)

# --- Trạng thái kích hoạt mô hình thật ---
USE_REAL_NLU=true              # true: Dùng PhoBERT / TF-IDF NLU; false: Mock NLU
USE_REAL_OCR=true              # true: Dùng PaddleOCR + VietOCR + LayoutLMv3; false: Mock OCR

# --- Khởi chạy mô hình sinh ngôn ngữ tự nhiên (NLG / LLM) ---
RUN_LLM=1                      # Bật LLM hỗ trợ NLU fallback và giải thích chi tiêu
RUN_LLM_CHITCHAT=1             # Bật LLM đối thoại phiếm Gen Z
LOG_MIMO_EMOTION=1             # Ghi nhận trạng thái cảm xúc của linh vật Mimo
LAZY_LOAD_MODELS=true          # Tải chậm các mô hình nặng để khởi động nhanh

# --- Tối ưu hóa suy luận cục bộ và nạp trước ---
PRELOAD_OCR=true
USE_ASYNC_PIPELINE=false
USE_LOCAL_PHOGPT=1

# --- Đường dẫn tương đối đến thư mục trọng số mô hình ---
EXPENSE_OCR_NLU_DIR=.
OCR_WEIGHTS_PATH=bill_ocr/models/vietocr/vgg_transformer.pth
LAYOUTLMV3_MODEL_PATH=bill_ocr/models/layoutlmv3/model_best.pth
ROTATION_MODEL_PATH=bill_ocr/receipt_ocr/mobilenetv3-Epoch-487-Loss-0.03-Acc-0.99.pth
VERIFIED_OCR_LABELS_DIR=bill_ocr/exported
KAGGLE_CONFIG_DIR=../app/backend

# --- Kết nối cơ sở dữ liệu (phục vụ script xuất tập dữ liệu huấn luyện) ---
# DATABASE_URL=postgresql://<username>:<password>@<host>:26257/spending-stories?sslmode=verify-full

# --- Khóa API Google Gemini (Dùng khi không có GPU cục bộ chạy Qwen/PhoGPT) ---
GEMINI_MODEL=gemini-2.5-flash
gemini_API_v1=your_gemini_api_key_1
gemini_API_v2=your_gemini_api_key_2
gemini_API_v3=your_gemini_api_key_3

# --- Khóa xác thực Hugging Face Hub (Tải mô hình nền tảng PhoBERT, LayoutLMv3, Qwen) ---
HF_TOKEN=your_huggingface_access_token
